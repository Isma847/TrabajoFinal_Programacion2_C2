<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      prefHeight="500.0"
      prefWidth="800.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="UI.controllers.ADMIN.MenuAdminController">

   <Label text="TEMUFLIX">
      <font>
         <Font name="System Bold" size="48.0"/>
      </font>
   </Label>

   <Label fx:id="lblCuenta" text="Panel de administración">
      <font>
         <Font name="System Bold" size="16.0"/>
      </font>
   </Label>

   <Button
           text="MENÚ DE USUARIO"
           onAction="#abrirMenuUsuario"
           prefHeight="45.0"
           prefWidth="320.0"/>

   <Button
           text="GESTIÓN ADMIN"
           onAction="#abrirGestionAdmin"
           prefHeight="45.0"
           prefWidth="320.0"/>

   <Button
           fx:id="btnCerrarSesion"
           text="CERRAR SESIÓN"
           onAction="#cerrarSesion"
           prefHeight="40.0"
           prefWidth="320.0"/>

</VBox>
