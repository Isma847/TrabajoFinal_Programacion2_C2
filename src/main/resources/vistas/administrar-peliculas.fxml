<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1000"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="UI.controllers.ADMIN.AdministrarPeliculasController">

    <top>
        <Label text="GESTIÓN DE PELÍCULAS"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 20;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 20;">

            <!-- LISTADO Y BOTONES -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <Label text="Listado de películas"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <ComboBox fx:id="cmbFiltroBaja"
                          promptText="Filtrar películas"
                          maxWidth="Infinity"/>


                <HBox spacing="8">
                    <TextField fx:id="txtBuscarId"
                               promptText="Ingresar ID general"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="BUSCAR"
                            onAction="#buscarPelicula"/>

                    <Button text="MOSTRAR TODAS"
                            onAction="#mostrarTodasLasPeliculas"/>
                </HBox>

                <TableView fx:id="tablaPeliculas"
                           prefHeight="300"
                           VBox.vgrow="NEVER">

                    <columns>
                        <TableColumn fx:id="colId" prefWidth="45" text="ID"/>
                        <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre"/>
                        <TableColumn fx:id="colDuracion" prefWidth="75" text="Duración"/>
                        <TableColumn fx:id="colGenero" prefWidth="100" text="Género"/>
                        <TableColumn fx:id="colClasificacion" prefWidth="100" text="Clasificación"/>
                        <TableColumn fx:id="colFecha" prefWidth="100" text="Estreno"/>
                        <TableColumn fx:id="colBaja" prefWidth="55" text="Baja"/>
                    </columns>
                </TableView>

                <!-- BOTONES DEBAJO DE LA TABLA -->
                <!-- BOTONES DEBAJO DE LA TABLA -->
                <HBox spacing="8">

                    <Button text="AGREGAR"
                            onAction="#agregarPelicula"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>

                    <Button text="MODIFICAR"
                            onAction="#modificarPelicula"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>

                    <Button text="DAR DE BAJA / REACTIVAR"
                            onAction="#cambiarEstadoPelicula"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>

                    <Button fx:id="btnVolver"
                            text="VOLVER ATRÁS"
                            onAction="#volver"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>

                </HBox>

            </VBox>

            <!-- FORMULARIO -->
            <VBox prefWidth="350" spacing="8">

                <Label text="Datos de la película"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <Label text="Nombre"/>
                <TextField fx:id="txtNombre"
                           promptText="Nombre de la película"/>

                <Label text="Duración (minutos)"/>
                <TextField fx:id="txtDuracion"
                           promptText="Ejemplo: 120"/>

                <Label text="Clasificación"/>
                <ComboBox fx:id="cmbClasificacion"
                          promptText="Seleccionar clasificación"
                          maxWidth="Infinity"/>

                <Label text="Género"/>
                <ComboBox fx:id="cmbGenero"
                          promptText="Seleccionar género"
                          maxWidth="Infinity"/>

                <Label text="Director"/>
                <ComboBox fx:id="cmbDirector"
                          promptText="Seleccionar director"
                          maxWidth="Infinity"/>

                <Label text="Fecha de estreno"/>
                <TextField fx:id="txtFecha"
                           promptText="Ejemplo: 2026-01-01"/>

                <Label text="Descripción"/>
                <TextArea fx:id="txtDescripcion"
                          prefRowCount="4"
                          promptText="Descripción de la película"
                          wrapText="true"/>

            </VBox>

        </HBox>
    </center>

</BorderPane>
