<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0"
      prefHeight="550.0" prefWidth="750.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="UI.controllers.USUARIO.ResenasUsuarioController">

    <Label text="Reseñas">
        <font>
            <Font name="System Bold" size="26.0"/>
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Tipo de contenido:"/>
        <ComboBox fx:id="comboTipo" prefWidth="150.0"
                  promptText="Seleccionar tipo"/>

        <Label text="Título:"/>
        <ComboBox fx:id="comboContenido" prefWidth="200.0"
                  promptText="Seleccionar título"/>
    </HBox>

    <TableView fx:id="tablaResenas" prefHeight="220.0"
               prefWidth="650.0">
        <columns>
            <TableColumn fx:id="colAutor"
                         prefWidth="90.0"
                         text="Autor (ID)"/>
            <TableColumn fx:id="colCalificacion"
                         prefWidth="120.0"
                         text="Calificación"/>
            <TableColumn fx:id="colComentario"
                         prefWidth="350.0"
                         text="Comentario"/>
            <TableColumn fx:id="colFecha"
                         prefWidth="170.0"
                         text="Fecha"/>
        </columns>
    </TableView>

    <Label fx:id="lblResumen" text="Seleccioná un contenido."/>

    <Label text="Publicar o modificar reseña">
        <font>
            <Font name="System Bold" size="16.0"/>
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Calificación (1-10):"/>
        <TextField fx:id="txtCalificacion" prefWidth="100.0"
                   promptText="1 a 10"/>
    </HBox>

    <TextArea fx:id="txtComentario"
              prefHeight="70.0"
              prefWidth="500.0"
              promptText="Escribí tu comentario..."/>

    <HBox alignment="CENTER" spacing="15.0">
        <Button text="Publicar" onAction="#publicarResena"/>
        <Button fx:id="btnModificar" text="Modificar" onAction="#modificarResena"/>
        <Button text="Volver al menú" onAction="#volverMenu"/>
    </HBox>

</VBox>