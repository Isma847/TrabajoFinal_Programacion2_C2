<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="800.0" spacing="18.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.controllers.MiCuentaController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="MI CUENTA" />
   <Label fx:id="lblRol" style="-fx-text-fill: #777777;" text="Rol" />

   <VBox spacing="10.0">
      <VBox.margin>
         <Insets left="120.0" right="120.0" />
      </VBox.margin>

      <Label style="-fx-font-weight: bold;" text="Datos personales" />
      <HBox spacing="10.0">
         <TextField fx:id="txtNombre" promptText="Nombre" HBox.hgrow="ALWAYS" />
         <TextField fx:id="txtApellido" promptText="Apellido" HBox.hgrow="ALWAYS" />
      </HBox>
      <HBox spacing="10.0">
         <TextField fx:id="txtUsuario" promptText="Nombre de usuario" HBox.hgrow="ALWAYS" />
         <TextField fx:id="txtEdad" promptText="Edad" HBox.hgrow="ALWAYS" />
      </HBox>

      <Label style="-fx-font-weight: bold;" text="Informacion de cuenta" />
      <TextField fx:id="txtEmail" editable="false" focusTraversable="false" promptText="Correo" style="-fx-opacity: 0.7;" />
      <PasswordField fx:id="txtContrasena" promptText="Nueva contraseña. Deje vacio si no desea cambiarla." />
   </VBox>

   <HBox alignment="CENTER" prefHeight="40.0" prefWidth="624.0" spacing="15.0">
      <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" prefHeight="40.0" prefWidth="180.0" text="Guardar cambios" />
      <Button fx:id="btnDarDeBaja" mnemonicParsing="false" onAction="#darDeBaja" prefHeight="40.0" prefWidth="180.0" style="-fx-border-color: red; -fx-border-width: 1; -fx-border-radius: 3;" text="Dar de baja" />
      <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverAlMenu" prefHeight="40.0" prefWidth="180.0" text="Volver al menu" />
   </HBox>
</VBox>
